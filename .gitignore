.venv/
__pycache__/
*.pyc
# 本地环境与密钥配置：不提交任何 .env 变体
.env
.env.*
.envrc
.secrets/
*.local.*
*.secret.*
.pytest_cache/
# IDE、Codex 与本地研究/运行辅助文件
.idea/
.vscode/
.codex/
.research/
.worktrees/
*.log
*.sqlite
*.sqlite3
*.db
*.tsbuildinfo
# 文档编辑器产生的文件（项目 Markdown 文档仍可提交）
*.doc
*.docx
*.docm
*.rtf
*.odt
# 设计阶段 spec/plan 不作为发布源码的一部分
docs/superpowers/specs/
docs/superpowers/plans/
# 项目设计、研究和验证文档只保留在本地
docs/
# 商品语料与品类知识语料均不入库：由 scripts/ 下生成脚本重建，只留在本机。
#   data/catalog-v1.jsonl  ← scripts/generate_catalog_fixture.py
#   knowledge/*.md         ← scripts/generate_knowledge_fixture.py
data/
knowledge/
# 根目录评测数据与报告只保留在本机；scripts/eval/ 中的 runner 仍随源码提交。
/eval/
/eval/releases/
/eval/verification/mallwork-eval-*/
/eval/report-*.md
# 召回评测报告同样是每次跑测的产物，不入库；标注集（eval/*.jsonl）要入库
/eval/recall-report-*.md
/eval/category-recall-report-*.md
